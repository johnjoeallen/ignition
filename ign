#!/usr/bin/env bash
# ign — the Ignition platform-admin CLI.
#
#   ign node   add|list|show|drain|undrain|rm
#   ign zone   create|list|show|status|move|destroy
#   ign app    list|show <zone> <name>|rm <zone> <name>   # deployed apps
#   ign sweep  [--dry-run]        # reclaim idle zones now
#   ign control                   # run the control-plane service (admin.<BASE_DOMAIN>)
#
# Everything reads/writes state/ under this repo. Run it from a host that can
# reach every node's Docker daemon (local socket, ssh://, or tcp://+TLS).
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

cmd="${1:-}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
    node)    exec "$HERE/scripts/node.sh" "$@" ;;
    zone)    exec "$HERE/scripts/zone.sh" "$@" ;;
    app)     exec "$HERE/scripts/app.sh" "$@" ;;
    sweep)   [ "${1:-}" = "--dry-run" ] && export DRY_RUN=1; exec "$HERE/scripts/sweep-idle.sh" ;;
    control) exec "$HERE/control/ign-control.py" "$@" ;;
    ""|-h|--help) sed -n '2,11p' "$0" | sed 's/^# \?//' ;;
    *) echo "unknown command: ign $cmd" >&2; exit 2 ;;
esac

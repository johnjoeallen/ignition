# Per-team stack: Gitea (git + PRs + Actions + registry) + a private
# Docker-in-Docker build engine + a Gitea Actions runner wired to it.
#
# Rendered by scripts/provision-team.sh with envsubst. Do not run directly.
# Substituted vars:
#   TEAM_SLUG BASE_DOMAIN TEAM_PORT
#   CPU_GITEA MEM_GITEA CPU_DIND MEM_DIND CPU_RUNNER MEM_RUNNER
#   RUNNER_TOKEN   (empty on the phase-1 apply, real on phase 2)
#
# One origin per team: http://${TEAM_SLUG}.${BASE_DOMAIN}:${TEAM_PORT}/ serves
# the web UI, git-over-http, the Actions API and the container registry — all
# of it, so `docker push` to that same host works. See CLAUDE.md.

name: team-${TEAM_SLUG}

networks:
  team-${TEAM_SLUG}:
    name: team-${TEAM_SLUG}

volumes:
  gitea-data:
    name: team-${TEAM_SLUG}-gitea-data
  dind-data:
    name: team-${TEAM_SLUG}-dind-data
  runner-data:
    name: team-${TEAM_SLUG}-runner-data

services:
  gitea:
    image: gitea/gitea:1.23
    container_name: team-${TEAM_SLUG}-gitea
    restart: unless-stopped
    networks: [team-${TEAM_SLUG}]
    ports:
      # Dedicated host port. Plain HTTP for now (see CLAUDE.md known gaps).
      - "${TEAM_PORT}:3000"
    environment:
      USER_UID: "1000"
      USER_GID: "1000"
      GITEA__server__DOMAIN: ${TEAM_SLUG}.${BASE_DOMAIN}
      GITEA__server__HTTP_PORT: "3000"
      GITEA__server__ROOT_URL: http://${TEAM_SLUG}.${BASE_DOMAIN}:${TEAM_PORT}/
      GITEA__server__SSH_DOMAIN: ${TEAM_SLUG}.${BASE_DOMAIN}
      GITEA__server__START_SSH_SERVER: "false"
      GITEA__server__DISABLE_SSH: "true"
      GITEA__database__DB_TYPE: sqlite3
      GITEA__actions__ENABLED: "true"
      GITEA__packages__ENABLED: "true"
      GITEA__service__DISABLE_REGISTRATION: "true"
      GITEA__security__INSTALL_LOCK: "true"
      GITEA__webhook__ALLOWED_HOST_LIST: "*"
      GITEA__migrations__ALLOWED_DOMAINS: "*"
      GITEA_WORK_DIR: /data/gitea
    volumes:
      - gitea-data:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:3000/api/healthz"]
      interval: 5s
      timeout: 3s
      retries: 30
    deploy:
      resources:
        limits: { cpus: "${CPU_GITEA}", memory: "${MEM_GITEA}" }

  dind:
    image: docker:27-dind
    container_name: team-${TEAM_SLUG}-dind
    restart: unless-stopped
    privileged: true                       # required for a nested engine
    networks: [team-${TEAM_SLUG}]           # only this team can reach it
    command: ["--host=tcp://0.0.0.0:2375", "--tls=false"]
    environment:
      DOCKER_TLS_CERTDIR: ""
    volumes:
      - dind-data:/var/lib/docker
    deploy:
      resources:
        limits: { cpus: "${CPU_DIND}", memory: "${MEM_DIND}" }

  act_runner:
    image: gitea/act_runner:0.2.11
    container_name: team-${TEAM_SLUG}-runner
    restart: unless-stopped
    networks: [team-${TEAM_SLUG}]
    depends_on:
      gitea: { condition: service_healthy }
      dind:  { condition: service_started }
    environment:
      GITEA_INSTANCE_URL: http://gitea:3000
      GITEA_RUNNER_REGISTRATION_TOKEN: "${RUNNER_TOKEN}"
      GITEA_RUNNER_NAME: team-${TEAM_SLUG}
      # `ubuntu-latest` jobs run in a docker-CLI-equipped image; `dind` jobs run
      # straight on the runner. Either way DOCKER_HOST points at the team's own
      # nested engine, never the host.
      GITEA_RUNNER_LABELS: "ubuntu-latest:docker://catthehacker/ubuntu:act-22.04,dind:host"
      DOCKER_HOST: tcp://dind:2375
    volumes:
      - runner-data:/data
    deploy:
      resources:
        limits: { cpus: "${CPU_RUNNER}", memory: "${MEM_RUNNER}" }

# Per-team stack: Forgejo (git + PRs + Actions + registry) + a private
# Docker-in-Docker build engine + a Forgejo Actions runner wired to it.
#
# Rendered by scripts/provision-team.sh with envsubst. Do not run directly.
# Substituted vars:
#   TEAM_SLUG BASE_DOMAIN
#   CPU_FORGEJO MEM_FORGEJO CPU_DIND MEM_DIND CPU_RUNNER MEM_RUNNER
#
# Forgejo has its own subdomain: https://git.${TEAM_SLUG}.${BASE_DOMAIN}/ serves
# the web UI, git-over-https, the Actions API and the container registry — all
# on one origin, so `docker push git.${TEAM_SLUG}.${BASE_DOMAIN}/...` works.
# Traefik on traefik-public terminates TLS for it. See CLAUDE.md.

name: team-${TEAM_SLUG}

networks:
  team-${TEAM_SLUG}:
    name: team-${TEAM_SLUG}
  traefik-public:
    external: true

volumes:
  forgejo-data:
    name: team-${TEAM_SLUG}-forgejo-data
  dind-data:
    name: team-${TEAM_SLUG}-dind-data
  runner-data:
    name: team-${TEAM_SLUG}-runner-data

services:
  forgejo:
    image: codeberg.org/forgejo/forgejo:11
    container_name: team-${TEAM_SLUG}-forgejo
    restart: unless-stopped
    networks: [team-${TEAM_SLUG}, traefik-public]
    environment:
      USER_UID: "1000"
      USER_GID: "1000"
      FORGEJO__server__DOMAIN: git.${TEAM_SLUG}.${BASE_DOMAIN}
      FORGEJO__server__HTTP_PORT: "3000"
      FORGEJO__server__ROOT_URL: https://git.${TEAM_SLUG}.${BASE_DOMAIN}/
      FORGEJO__server__START_SSH_SERVER: "false"
      FORGEJO__server__DISABLE_SSH: "true"
      FORGEJO__database__DB_TYPE: sqlite3
      FORGEJO__actions__ENABLED: "true"
      FORGEJO__packages__ENABLED: "true"
      FORGEJO__service__DISABLE_REGISTRATION: "true"
      FORGEJO__security__INSTALL_LOCK: "true"
      FORGEJO__repository__ENABLE_PUSH_CREATE_USER: "true"
      FORGEJO__repository__DEFAULT_PUSH_CREATE_PRIVATE: "false"
      FORGEJO__webhook__ALLOWED_HOST_LIST: "*"
      FORGEJO__migrations__ALLOWED_DOMAINS: "*"
    labels:
      traefik.enable: "true"
      traefik.docker.network: traefik-public
      traefik.http.routers.team-${TEAM_SLUG}-git.rule: Host(`git.${TEAM_SLUG}.${BASE_DOMAIN}`)
      traefik.http.routers.team-${TEAM_SLUG}-git.entrypoints: websecure
      traefik.http.routers.team-${TEAM_SLUG}-git.tls: "true"
      # One wildcard cert per team covers git.<slug> (and future <x>.<slug>).
      traefik.http.routers.team-${TEAM_SLUG}-git.tls.domains[0].main: ${TEAM_SLUG}.${BASE_DOMAIN}
      traefik.http.routers.team-${TEAM_SLUG}-git.tls.domains[0].sans: "*.${TEAM_SLUG}.${BASE_DOMAIN}"
      traefik.http.services.team-${TEAM_SLUG}-git.loadbalancer.server.port: "3000"
    volumes:
      - forgejo-data:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:3000/api/healthz"]
      interval: 5s
      timeout: 3s
      retries: 30
    deploy:
      resources:
        limits: { cpus: "${CPU_FORGEJO}", memory: "${MEM_FORGEJO}" }

  dind:
    image: docker:27-dind
    container_name: team-${TEAM_SLUG}-dind
    restart: unless-stopped
    privileged: true                       # required for a nested engine
    networks: [team-${TEAM_SLUG}]           # only this team can reach it
    command: ["--host=tcp://0.0.0.0:2375"]
    environment:
      DOCKER_TLS_CERTDIR: ""                # plaintext daemon, team net only
    volumes:
      - dind-data:/var/lib/docker
    deploy:
      resources:
        limits: { cpus: "${CPU_DIND}", memory: "${MEM_DIND}" }

  runner:
    image: code.forgejo.org/forgejo/runner:13
    container_name: team-${TEAM_SLUG}-runner
    restart: unless-stopped
    networks: [team-${TEAM_SLUG}]
    depends_on:
      forgejo: { condition: service_healthy }
      dind:    { condition: service_started }
    # runner-config.yml is generated next to this file by provision-team.sh
    # (url + uuid + token from the shared secret) — templating a sed-mangled
    # runner config here would get ugly.
    command: ["forgejo-runner", "--config", "/config.yml", "daemon"]
    environment:
      DOCKER_HOST: tcp://dind:2375           # jobs build against the team's own engine
    volumes:
      - runner-data:/data
      - ./runner-config.yml:/config.yml:ro
    deploy:
      resources:
        limits: { cpus: "${CPU_RUNNER}", memory: "${MEM_RUNNER}" }

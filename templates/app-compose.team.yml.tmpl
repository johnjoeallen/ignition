# A team's live demo app. Rendered and applied by scripts/deploy-agent.py on
# the host (NOT inside the team's DinD sandbox — see CLAUDE.md), so Traefik on
# traefik-public can route https://${TEAM_SLUG}.${BASE_DOMAIN}/ to it.
#
# Substituted vars: TEAM_SLUG BASE_DOMAIN APP_IMAGE APP_PORT DEPLOY_ID

name: team-${TEAM_SLUG}-app

networks:
  traefik-public:
    external: true

services:
  app:
    image: ${APP_IMAGE}
    container_name: team-${TEAM_SLUG}-app
    restart: unless-stopped
    networks: [traefik-public]
    labels:
      hackzone.team: ${TEAM_SLUG}
      hackzone.deploy-id: "${DEPLOY_ID}"
      traefik.enable: "true"
      traefik.docker.network: traefik-public
      traefik.http.routers.team-${TEAM_SLUG}.rule: Host(`${TEAM_SLUG}.${BASE_DOMAIN}`)
      traefik.http.routers.team-${TEAM_SLUG}.entrypoints: websecure
      traefik.http.routers.team-${TEAM_SLUG}.tls: "true"
      traefik.http.services.team-${TEAM_SLUG}.loadbalancer.server.port: "${APP_PORT}"
    deploy:
      resources:
        limits: { cpus: "${CPU_APP}", memory: "${MEM_APP}" }

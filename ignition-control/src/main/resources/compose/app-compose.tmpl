# One deployed app. A zone can deploy many; each app name is unique within its
# zone and the app lives at https://${APP_NAME}.apps.${ZONE_SLUG}.${BASE_DOMAIN}/.
# Rendered and applied by the control plane (control/ign-control.py) on the owning
# zone's node — NOT inside the zone's DinD sandbox (see CLAUDE.md) — so that
# node's Traefik can route to it. The zone's Forgejo router holds a
# *.apps.${ZONE_SLUG}.${BASE_DOMAIN} cert, so no per-name cert is needed.
#
# Substituted vars: APP_NAME ZONE_SLUG BASE_DOMAIN APP_IMAGE APP_PORT DEPLOY_ID CPU_APP MEM_APP

name: app-${ZONE_SLUG}-${APP_NAME}

networks:
  traefik-public:
    external: true

services:
  app:
    image: ${APP_IMAGE}
    container_name: app-${ZONE_SLUG}-${APP_NAME}
    restart: unless-stopped
    networks: [traefik-public]
    environment:
      PORT: "${APP_PORT}"
    labels:
      ignition.app: ${APP_NAME}
      ignition.zone: ${ZONE_SLUG}
      ignition.deploy-id: "${DEPLOY_ID}"
      # ign-control adds this to EVERY deployed app automatically — teams never
      # opt in. The per-node Watchtower (traefik-core-compose.yml) then rolls
      # the container forward whenever its image tag gets a new digest.
      com.centurylinklabs.watchtower.enable: "true"
      traefik.enable: "true"
      traefik.docker.network: traefik-public
      traefik.http.routers.app-${ZONE_SLUG}-${APP_NAME}.rule: Host(`${APP_NAME}.apps.${ZONE_SLUG}.${BASE_DOMAIN}`)
      traefik.http.routers.app-${ZONE_SLUG}-${APP_NAME}.entrypoints: websecure
      traefik.http.routers.app-${ZONE_SLUG}-${APP_NAME}.tls: "true"
      traefik.http.services.app-${ZONE_SLUG}-${APP_NAME}.loadbalancer.server.port: "${APP_PORT}"
    deploy:
      resources:
        limits: { cpus: "${CPU_APP}", memory: "${MEM_APP}" }

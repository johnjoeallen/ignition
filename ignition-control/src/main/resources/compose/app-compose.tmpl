# One deployed app on one channel. A zone can deploy many; each app name is
# unique within its zone. The release channel lives at
# https://${APP_NAME}.apps.${ZONE_SLUG}.${BASE_DOMAIN}/ (from a release tag);
# the dev channel at https://${APP_NAME}.dev.${ZONE_SLUG}.${BASE_DOMAIN}/ (the
# latest main HEAD, shipped only from the console's "Deploy from main" button).
# ${APP_HOST} / ${APP_PROJECT} carry whichever this render is for.
#
# Rendered and applied by the control plane on the owning zone's node — NOT
# inside the zone's DinD sandbox (see CLAUDE.md) — so that node's Traefik can
# route to it. The zone's Forgejo router holds *.apps.${ZONE_SLUG}.${BASE_DOMAIN}
# and *.dev.${ZONE_SLUG}.${BASE_DOMAIN} certs, so no per-name cert is needed.
#
# Substituted vars: APP_NAME ZONE_SLUG BASE_DOMAIN APP_HOST APP_PROJECT
#                   APP_IMAGE APP_PORT DEPLOY_ID CPU_APP MEM_APP

name: ${APP_PROJECT}

networks:
  traefik-public:
    external: true

services:
  app:
    image: ${APP_IMAGE}
    container_name: ${APP_PROJECT}
    restart: unless-stopped
    networks: [traefik-public]
    environment:
      PORT: "${APP_PORT}"
    labels:
      ignition.app: ${APP_NAME}
      ignition.zone: ${ZONE_SLUG}
      ignition.deploy-id: "${DEPLOY_ID}"
      # ign-control adds this to EVERY deployed app automatically — teams never
      # opt in. The per-node Watchtower (traefik-core-compose.yml) then rolls
      # the container forward whenever its image tag gets a new digest.
      com.centurylinklabs.watchtower.enable: "true"
      traefik.enable: "true"
      traefik.docker.network: traefik-public
      traefik.http.routers.${APP_PROJECT}.rule: Host(`${APP_HOST}`)
      traefik.http.routers.${APP_PROJECT}.entrypoints: websecure
      traefik.http.routers.${APP_PROJECT}.tls: "true"
      traefik.http.services.${APP_PROJECT}.loadbalancer.server.port: "${APP_PORT}"
    deploy:
      resources:
        limits: { cpus: "${CPU_APP}", memory: "${MEM_APP}" }

#!/usr/bin/env bash
# hz — the hackzone platform-admin CLI.
#
#   hz node   add|list|show|drain|undrain|rm
#   hz zone   create|list|show|status|move|destroy
#   hz sweep  [--dry-run]        # reclaim idle zones now
#   hz control                   # run the control-plane service (zone-admin surface + CI deploy bridge)
#
# Everything reads/writes state/ under this repo. Run it from a host that can
# reach every node's Docker daemon (local socket, ssh://, or tcp://+TLS).
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

cmd="${1:-}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
    node)    exec "$HERE/scripts/node.sh" "$@" ;;
    zone)    exec "$HERE/scripts/zone.sh" "$@" ;;
    sweep)   [ "${1:-}" = "--dry-run" ] && export DRY_RUN=1; exec "$HERE/scripts/sweep-idle.sh" ;;
    control) exec "$HERE/control/hz-control.py" "$@" ;;
    ""|-h|--help) sed -n '2,10p' "$0" | sed 's/^# \?//' ;;
    *) echo "unknown command: hz $cmd" >&2; exit 2 ;;
esac
